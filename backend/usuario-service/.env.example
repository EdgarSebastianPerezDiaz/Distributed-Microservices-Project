# Variables de Entorno - Usuario Service OAuth 2.0
# Usar en producción - NO commitar en Git

## Database
DATABASE_URL=jdbc:postgresql://db-server:5432/usuarios_db
DATABASE_USER=postgres
DATABASE_PASSWORD=StrongPasswordHere!

## OAuth 2.0
# Secretos de clientes (generar con: openssl rand -base64 32)
OAUTH2_FRONTEND_SECRET=your-secure-frontend-secret-here-min-32-chars
OAUTH2_MICROSERVICES_SECRET=your-secure-microservices-secret-here-min-32-chars

# URI del servidor (cambiar a dominio real en producción)
ISSUER_URI=https://usuarios.tu-dominio.com

## Spring
SPRING_PROFILES_ACTIVE=prod

## Eureka
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

## Logging
LOGGING_LEVEL_COM_DISTRIBUIDOS=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN

# Ejemplo para Docker
# docker run -e OAUTH2_FRONTEND_SECRET=... -e OAUTH2_MICROSERVICES_SECRET=... usuario-service:latest
